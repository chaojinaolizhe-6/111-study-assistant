\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces 直流稳压电源的四步链。变压器只改变交流电压的幅值；整流把负半周翻正；滤波把脉动削平；稳压管把输出钉在 $U_Z$ 附近。}}{3}{figure.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces 三个关键波形（纵轴以 $U_2$ 为基准，纹波已适当放大）：(a) 副边正弦，峰值 $\sqrt  2U_2$、周期 $20\,\mathrm  {ms}$；(b) 全波整流，平均值 $0.9U_2$、脉动周期 $10\,\mathrm  {ms}$；(c) 电容滤波，平均值约 $1.2U_2$，峰谷差为纹波 $V_r$。}}{4}{figure.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces 测量电路示意（简化）：$T_1$ 与 $D_1$ 用方框表示，重点是 $K_1$--$K_3$ 三条支路和 $U_{o1}$、$U_{o2}$ 的测量位置。完整接线见手册 p11。}}{6}{figure.3}\protected@file@percent }
