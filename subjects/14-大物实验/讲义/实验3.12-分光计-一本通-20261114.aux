\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces 为什么像落在上叉丝（示意，角度已放大；实际 $\theta =a/f\approx 0.6^{\circ }$）。紫实线＝出射，灰虚线＝返回。物点「十」在轴下 $a$，出射平行光上倾；反射后向另一侧倾斜，经物镜落在轴上 $+a$，即上叉丝。}}{5}{figure.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces 平面镜在载物台上的两种摆法（讲义 p9 图 12-10）：(a) 镜面平行于一对螺钉连线；(b) 镜面垂直于一对螺钉连线。两种都行，关键是反射面朝望远镜、镜面竖直。$a,b,c$ 是三个调平螺钉。}}{6}{figure.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces 三棱镜在载物台上的方位（讲义 p11 图 12-11）：$AB\perp a_1a_2$、$AC\perp a_2a_3$、$BC\perp a_3a_1$。这样 $a_1$ 只改变 $AB$ 面法线、$a_3$ 只改变 $AC$ 面法线，两个面可以各自独立调平。}}{10}{figure.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces 反射法测顶角的两个望远镜位置（讲义 p11 图 12-12）：顶点 $A$ 对住准直管，$AB$、$AC$ 两面各反射一束，望远镜在 I、II 两处读 $\phi _1,\phi _1'$ 与 $\phi _2,\phi _2'$。}}{11}{figure.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces 棱镜主截面内的折射（讲义 p6 图 12-6）：$A$ 顶角 $\alpha $，$S\to O$ 入射，$O'\to S'$ 出射，$\delta $ 偏向角，$i,i'$ 入射角，$r,r'$ 折射角，$N,N'$ 法线。}}{12}{figure.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces 最小偏向角的两次测量（讲义 p12 图 12-13）：(a) 光从 $AB$ 入、$AC$ 出；(b) 同一入射光改从 $AC$ 入、$AB$ 出。两次出射方向各偏 $\delta _{\min }$，夹角 $2\delta _{\min }$。}}{14}{figure.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces 光栅衍射的几何（讲义 p7 图 12-7）：间距 $d$ 的相邻缝，沿与法线成 $\varphi $ 的方向，光程差为 $d\sin \varphi $；对称出现零级与 $\pm 1,\pm 2$ 各级主极大。}}{17}{figure.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces 光栅在载物台上的方位与三个螺钉（讲义 p13 图 12-14）：$b_1,b_2$ 调栅面垂直光轴，$b_3$ 调栅缝方向；$b_1b_2$ 连线被栅面垂直平分。}}{18}{figure.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces 汞灯的多级光谱（讲义 p8 图 12-9）：中央是零级（白亮），两侧对称出现一级、二级。级次越高越暗、越散开，所以二级要仔细找。}}{18}{figure.9}\protected@file@percent }
