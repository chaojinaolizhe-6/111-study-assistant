\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces JJY1 型分光计全貌（裁剪自讲义 p2 图 12-1，保留原图 1--28 编号；原图英文图注见讲义 p2，本讲把它整理成下表）。}}{4}{figure.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces 自准直望远镜的光学结构（裁剪自讲义 p2 图 12-2）：目镜（Eyepiece）—分划板（Reticle）—物镜（Objective lens），分划板前有全反射棱镜（Prism），小灯（Light）从侧面照明。}}{6}{figure.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces 分划板与反射「十」像（裁剪自讲义 p3 图 12-3）：(a) 分划板本身：1 上叉丝、2 中心横丝、3 透光「十」、4 绿色透光区；(b) 反射像 5 落在上叉丝下方；(c) 反射像与上叉丝重合——即调好的状态。}}{6}{figure.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces 为什么像是上叉丝（示意，角度已放大；实际 $\theta =a/f\approx 0.6^{\circ }$）。紫色实线＝出射，灰色虚线＝返回。物点「十」在轴下 $a$，经物镜成平行光向上倾斜；反射只反转轴向分量，回来的平行光向另一侧倾斜，再经物镜落在轴上 $+a$，即上叉丝。}}{7}{figure.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces 度盘与游标（裁剪自讲义 p4 图 12-4）：外圈是度盘主尺（$335,340,345,350$ 可见），内圈是游标（$0$--$30$）。主尺最小分格 $30'$，游标分度值 $1'$。}}{10}{figure.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces 度盘中心与主轴中心的偏心（裁剪自讲义 p5 图 12-5）：$O$ 是主轴中心，$O'$ 是度盘中心，$\phi $ 是望远镜绕主轴的实际转角，$\theta _1,\theta _2$ 是两个游标给出的读数。图中标出的四个角就是讲义 $(12\text  {-}1)(12\text  {-}2)$ 里的 $\angle 1$--$\angle 4$。}}{11}{figure.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces 平面镜在载物台上的两种摆法（裁剪自讲义 p9 图 12-10）：(a) 镜面平行于一对螺钉连线；(b) 镜面垂直于一对螺钉连线。两种都可以，关键是让反射面朝向望远镜、镜面竖直。图中 $a,b,c$ 是载物台的三个调平螺钉。}}{14}{figure.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces 三棱镜在载物台上的方位（裁剪自讲义 p11 图 12-11）：$AB\perp a_1a_2$、$AC\perp a_2a_3$、$BC\perp a_3a_1$。这样 $a_1$ 只改变 $AB$ 面的法线方向、$a_3$ 只改变 $AC$ 面的法线方向，两个面可以\textbf  {各自独立}调平。}}{16}{figure.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces 棱镜主截面内的折射（裁剪自讲义 p6 图 12-6）：$A$ 为顶角 $\alpha $，$S\to O$ 为入射光，$O'\to S'$ 为出射光，$\delta $ 为偏向角；$i,i'$ 为两个面上的入射角、$r,r'$ 为折射角，$N,N'$ 为两面法线。}}{18}{figure.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces 光栅衍射的几何（裁剪自讲义 p7 图 12-7）：入射平行光照到间距为 $d$ 的缝上，沿与法线成 $\varphi $ 的方向，相邻缝的光程差为 $d\sin \varphi $；屏幕上对称出现零级与 $\pm 1,\pm 2$ 各级主极大。}}{21}{figure.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces 光栅在载物台上的方位与三个螺钉（裁剪自讲义 p13 图 12-14）：$b_1,b_2$ 调栅面垂直光轴，$b_3$ 调栅缝方向；$b_1b_2$ 连线被栅面垂直平分。}}{22}{figure.11}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces 答案里照这张画（讲义 p9 图 12-10）：镜面竖直立在载物台上，一个反射面朝向望远镜，三个调平螺钉 $a,b,c$ 标出。}}{29}{figure.12}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces 答案里照这张画（讲义 p11 图 12-12）：顶点 $A$ 对着准直管，$AB$、$AC$ 两个反射面各反射一束光，望远镜在位置 I 与 II 分别读数 $\phi _1,\phi _1'$ 与 $\phi _2,\phi _2'$。}}{30}{figure.13}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces 答案里照这张画（讲义 p12 图 12-13）：(a) 光从 $AB$ 入、$AC$ 出；(b) 同一入射光改从 $AC$ 入、$AB$ 出；两次出射方向各偏 $\delta _{\min }$，夹角 $2\delta _{\min }$。}}{30}{figure.14}\protected@file@percent }
