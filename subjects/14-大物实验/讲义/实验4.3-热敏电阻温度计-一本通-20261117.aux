\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces 手册 p1 的原图（裁自 PDF 第 1 页，300\,dpi 以上）。C、D 之间为 $U_{cd}$；A、B 之间为微安表；$R_t$ 是热敏电阻，其余三个是可调电阻。原题注误印为“Schematic diagram of digital oscilloscope”，照原样保留以便对页。}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:bridge}{{1}{5}{手册 p1 的原图（裁自 PDF 第 1 页，300\,dpi 以上）。C、D 之间为 $U_{cd}$；A、B 之间为微安表；$R_t$ 是热敏电阻，其余三个是可调电阻。原题注误印为“Schematic diagram of digital oscilloscope”，照原样保留以便对页。}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces 同一张电路，按本讲义的画法重排（$A$ 上、$B$ 下、$C$ 左、$D$ 右，与手册原图位置一致）。分压器接法：电源 $E$ 与开关 $K$ 跨接在电位器 $R$ 的\textbf  {两端}，C 接 $R$ 的一端、D 接\textbf  {滑片}，所以 C、D 之间的电压是 $R$ 上被切出的那一段。$U_{cd}\le E$，可用滑片连续调。}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:bridge2}{{2}{5}{同一张电路，按本讲义的画法重排（$A$ 上、$B$ 下、$C$ 左、$D$ 右，与手册原图位置一致）。分压器接法：电源 $E$ 与开关 $K$ 跨接在电位器 $R$ 的\textbf {两端}，C 接 $R$ 的一端、D 接\textbf {滑片}，所以 C、D 之间的电压是 $R$ 上被切出的那一段。$U_{cd}\le E$，可用滑片连续调。}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces 校准曲线怎么用（曲线按 §5.3 的示例参数画，现场用你自己的 11 个数重画）。\textbf  {正查}：已知温度 $45\ensuremath {\,^\circ \mathrm  {C}}$ 竖直上去交曲线，再横读到 $56.5\,\mu $A，用来检查测量是否合理。\textbf  {反查}（真正测温时用）：已知电流 $40\,\mu $A 横着交曲线，再竖直下来读 $\approx 30.6\ensuremath {\,^\circ \mathrm  {C}}$。注意反查不是把坐标轴交换着画，而是在同一条曲线上换方向走。}}{12}{figure.3}\protected@file@percent }
\newlabel{fig:curve}{{3}{12}{校准曲线怎么用（曲线按 §5.3 的示例参数画，现场用你自己的 11 个数重画）。\textbf {正查}：已知温度 $45\degC $ 竖直上去交曲线，再横读到 $56.5\,\mu $A，用来检查测量是否合理。\textbf {反查}（真正测温时用）：已知电流 $40\,\mu $A 横着交曲线，再竖直下来读 $\approx 30.6\degC $。注意反查不是把坐标轴交换着画，而是在同一条曲线上换方向走。}{figure.3}{}}
