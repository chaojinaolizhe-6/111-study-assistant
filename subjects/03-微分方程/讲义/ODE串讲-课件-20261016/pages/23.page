      lineHeight: 1.2
      align: left
  - elementId: h1
    elementType: text
    bounds: [104, 266, 800, 44]
    content:
      text: "yy″+2(y′)²=0 ⟹ 令 p=p(y)"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 22
      bold: true
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: b1
    elementType: text
    bounds: [104, 312, 808, 38]
    content:
      text: "y·p·pᵧ+2p²=0；先保留 p=0，其余得 p=K/y²，最终 y³=Ax+B。A≠0 时要避开 Ax+B=0。"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 17
      color: "#243F35"
      lineHeight: 1.2
      align: left
