      color: "#6E7F72"
      lineHeight: 1.2
      align: left
  - elementId: h2
    elementType: text
    bounds: [104, 362, 800, 44]
    content:
      text: "x²yy″−x²(y′)²=2xyy′"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 22
      bold: true
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: b2
    elementType: text
    bounds: [104, 408, 808, 38]
    content:
      text: "先补 y=0；在 x≠0、y≠0 令 z=y′/y，得 xz′=2z，故 z=Kx²，积分得 y=A·exp(Bx³)。"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 17
      color: "#243F35"
      lineHeight: 1.2
      align: left
