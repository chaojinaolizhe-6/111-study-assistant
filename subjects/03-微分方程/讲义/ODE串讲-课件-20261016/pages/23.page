  - elementId: b0
    elementType: text
    bounds: [104, 216, 808, 38]
    content:
      text: "z′+z=x+1 给 z=x+C₁e⁻ˣ，再积分两次得 y=x³/6+C₁e⁻ˣ+C₂x+C₃。"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 17
