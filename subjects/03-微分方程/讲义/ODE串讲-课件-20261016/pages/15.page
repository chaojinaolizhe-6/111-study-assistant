      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 12
      bold: true
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: c3_1
    elementType: text
    bounds: [284, 317, 318, 30]
