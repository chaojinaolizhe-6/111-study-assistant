      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 12
      bold: true
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: c1_1
    elementType: text
    bounds: [284, 241, 318, 30]
    content:
      text: "(Nₓ−Mᵧ)/M 仅依赖 y"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 12
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: c1_2
    elementType: text
    bounds: [614, 241, 286, 30]
    content:
      text: "μ = exp{∫[(Nₓ−Mᵧ)/M]dy}"
