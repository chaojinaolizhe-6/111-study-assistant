      fontSize: 12
      bold: true
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: c5_1
    elementType: text
    bounds: [284, 393, 318, 30]
    content:
      text: "y(1−y)dx+x dy=0：μ=(1−y)⁻²，得 y=C/(x+C)，须补 y≡1"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 10
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: c5_2
    elementType: text
    bounds: [614, 393, 286, 30]
    content:
      text: "y dx+(2x+1/y)dy=0：μ=y，乘后 xy²+y=C；C=0 给 y=0 或 y=−1/x，其中 y=0 是伪解"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 10
      color: "#243F35"
      lineHeight: 1.2
      align: left
