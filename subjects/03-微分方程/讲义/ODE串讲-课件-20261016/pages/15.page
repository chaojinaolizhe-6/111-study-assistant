      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 12
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: c4_2
    elementType: text
    bounds: [614, 355, 286, 30]
    content:
      text: "μ = 1/(xM−yN)"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 12
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: r4
