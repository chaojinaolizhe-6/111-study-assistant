      fontSize: 12
      bold: true
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: c2_1
    elementType: text
    bounds: [284, 279, 318, 30]
    content:
      text: "E=(Mᵧ−Nₓ)/(Nωₓ−Mωᵧ) 仅依赖 ω"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 12
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: c2_2
    elementType: text
    bounds: [614, 279, 286, 30]
    content:
      text: "μ = exp[∫E(ω)dω]"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 12
      color: "#243F35"
      lineHeight: 1.2
