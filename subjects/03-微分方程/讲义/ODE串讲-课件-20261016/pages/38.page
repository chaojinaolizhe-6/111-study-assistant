      lineHeight: 1.2
      align: left
  - elementId: c4_2
    elementType: text
    bounds: [528, 373, 372, 34]
    content:
      text: "令 p=p(y)，y″=p·dp/dy，补 p=0"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
