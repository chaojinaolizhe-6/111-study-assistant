      align: left
  - elementId: c0_2
    elementType: text
    bounds: [528, 205, 372, 34]
    content:
      text: "μ=e^(∫1 dx)，或直接分离变量"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 14
      color: "#243F35"
