      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 14
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: c2_2
    elementType: text
    bounds: [528, 289, 372, 34]
    content:
      text: "先定权重 α=2，令 y=x²u"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 14
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: r2
