      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 14
      bold: true
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: c3_1
    elementType: text
    bounds: [298, 331, 218, 34]
    content:
      text: "Clairaut"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 14
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: c3_2
    elementType: text
    bounds: [528, 331, 372, 34]
    content:
      text: "对 x 求导得 (x+2p)p′=0，分两支"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 14
      color: "#243F35"
