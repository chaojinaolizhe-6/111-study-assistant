  - elementId: c2_0
    elementType: text
    bounds: [48, 289, 238, 34]
    content:
      text: "y′=y/x+x³/y"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 14
      bold: true
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: c2_1
    elementType: text
    bounds: [298, 289, 218, 34]
    content:
