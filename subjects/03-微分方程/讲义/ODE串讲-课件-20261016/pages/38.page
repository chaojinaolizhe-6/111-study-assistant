  - elementId: c1_0
    elementType: text
    bounds: [48, 247, 238, 34]
    content:
      text: "y′=(x+y)/(x−y)"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 14
      bold: true
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: c1_1
    elementType: text
    bounds: [298, 247, 218, 34]
    content:
      text: "一阶齐次"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 14
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: c1_2
    elementType: text
    bounds: [528, 247, 372, 34]
    content:
      text: "令 y=xu，得 xu′=(1+u)/(1−u)−u"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 14
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: r1
