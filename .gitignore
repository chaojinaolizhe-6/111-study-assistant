# ============================================================
# 111学习助手 · GitHub 同步排除规则
# 分层依据见 .tutor/docs/同步到GitHub.md
# 建立：2026-10-14
# ============================================================

# ---------- OS / 编辑器元数据 ----------
.DS_Store
**/.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# ---------- Python 缓存 ----------
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ---------- 凭据与密钥（即使出现也绝不入库）----------
.env
.env.*
credentials.json
*.key
*.pem
*.pfx
id_rsa*
id_ed25519*

# ---------- 半截文件 / 临时文件 / 手工备份 ----------
*.part
*.tmp
*.orig
*.rej
*.bak
*.bak[0-9]*
*.bak-*
*.bak2-*
/_tmp_*
/tmp-*

# ---------- 第 ④ 层：工作区临时与中间产物（本地专属）----------
# 理由：可由原始资料或工具重新生成，且占 1 GB；上传只会拖慢克隆。
/_scratch/
/_package-portable/
/_tmp_pdf/
/backups/

# 课件/教材的中间渲染缓存（.tutor/cache/materials 是解构产物，保留）
.tutor/cache/_inspect/

# ---------- 验证用临时克隆 ----------
/_verify-clone/

# ---------- 公开库隐私：会话原文与检查包 ----------
# 2026-10-14 用户决定：仓库将转为公开，eval/ 含完整会话原文（含系统提示词与
# 工具 schema）与个人检查包，必须移出版本控制。
# ⚠ 仅加 .gitignore 不够——旧 commit 里仍有副本，公开后会随历史泄露。
#   已于 2026-10-14 用 git filter-branch 从**全部历史**清除（见 AUDIT 文档）。
/eval/

# ---------- 公开库安全闸门：第三方版权材料 ----------
# 以下为第三方版权 PDF（教材库含 Z-Library 来源、课件为任课教师讲义）。
# 用户在**私有**仓库中上传无碍；一旦仓库转公开即为公开分发，存在 DMCA 风险。
# 若最终决定仓库公开，请取消下面两行注释、并把它们从历史中一并清除。
# /obsidian/教材库/
# /subjects/

# ============================================================
# 以下内容**明确保留**（不要加进本文件）：
#   learning/  · 作答、订正、困难、目标、题目 —— 能力事实源
#   state/     · 派生状态与当前状态事实卡
#   plan/      · 排期与续学入口
#   subjects/  · 各课 INDEX / 作业 / 课堂记录（含课件与作业照片）
#   eval/      · 会话历史（另一个 AI 理解来龙去脉的依据）
#   .tutor/    · 协议、配置、技能、课件解构缓存
#   obsidian/  · 笔记与教材解构成果
# 理由：本地工作区要能回滚；这些是"另一个 AI 缺了就干不了活"的部分。
# ============================================================

# ---------- 版权提醒（用户 2026-10-14 知悉后选择上传，仓库为私有）----------
# obsidian/教材库/ 内含第三方版权教材（部分来源标注 Z-Library）。
# 私有仓库风险可控。**若日后将本仓库改为公开**，请取消下面一行注释，
# 把教材库整体移出版本控制，避免 DMCA 投诉。
# obsidian/教材库/
