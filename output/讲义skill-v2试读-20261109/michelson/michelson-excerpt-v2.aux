\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces 等效空气膜的局部几何（自绘，依据讲义 p3--p4 图 11-2/11-3 与 p6 图 11-5 的文字描述；角度放大，\(d\) 为 \(M_1\) 与 \(M_2'\) 的间距）。光束 1 在 \(A\) 点反射；光束 2 在 \(A\) 点透射入膜，到 \(B\) 点反射，再从 \(C\) 点出射。\(AB=BC=d/\cos \theta \)；\(A\)、\(C\) 的水平错开 \(AC=2d\tan \theta \)；过 \(C\) 且垂直于出射光的是比较波面，它与光束 1 交于 \(D\)，故 \(AD=AC\sin \theta =2d\tan \theta \sin \theta \)。}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:film}{{1}{6}{等效空气膜的局部几何（自绘，依据讲义 p3--p4 图 11-2/11-3 与 p6 图 11-5 的文字描述；角度放大，\(d\) 为 \(M_1\) 与 \(M_2'\) 的间距）。光束 1 在 \(A\) 点反射；光束 2 在 \(A\) 点透射入膜，到 \(B\) 点反射，再从 \(C\) 点出射。\(AB=BC=d/\cos \theta \)；\(A\)、\(C\) 的水平错开 \(AC=2d\tan \theta \)；过 \(C\) 且垂直于出射光的是比较波面，它与光束 1 交于 \(D\)，故 \(AD=AC\sin \theta =2d\tan \theta \sin \theta \)。}{figure.1}{}}
\newlabel{eq:dl}{{1}{7}{}{equation.0.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces 两虚源与屏上环半径（自绘，依据讲义 p3--p4 图 11-3/11-4）。\(S_1\)、\(S_2'\) 相距 \(2d\)；屏与 \(S_1S_2'\) 垂直时得到同心圆。\(\theta \) 是 \(S_1P\) 与轴线 \(S_1S_2'\) 的夹角，\(\theta \approx r/z\)。}}{8}{figure.2}\protected@file@percent }
\newlabel{fig:virtual}{{2}{8}{两虚源与屏上环半径（自绘，依据讲义 p3--p4 图 11-3/11-4）。\(S_1\)、\(S_2'\) 相距 \(2d\)；屏与 \(S_1S_2'\) 垂直时得到同心圆。\(\theta \) 是 \(S_1P\) 与轴线 \(S_1S_2'\) 的夹角，\(\theta \approx r/z\)。}{figure.2}{}}
\newlabel{eq:count}{{2}{9}{}{equation.0.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Q II-1 的作答光路图（自绘，俯视示意，距离不按实物比例）。光线实线为去程、虚线为返程，略微错开只为看清方向，实际在各臂往返重合。输入端扩束后，光束 I 去 \(M_1\)，光束 II 经 \(G_2\) 去 \(M_2\)；两束回到 \(G_1\) 合束后向下到 \(E\)。上方虚线镜 \(M_2'\) 是 \(M_2\) 经 \(G_1\) 的虚像，\(d=|M_1M_2'|\)。}}{12}{figure.3}\protected@file@percent }
\newlabel{fig:lightpath}{{3}{12}{Q II-1 的作答光路图（自绘，俯视示意，距离不按实物比例）。光线实线为去程、虚线为返程，略微错开只为看清方向，实际在各臂往返重合。输入端扩束后，光束 I 去 \(M_1\)，光束 II 经 \(G_2\) 去 \(M_2\)；两束回到 \(G_1\) 合束后向下到 \(E\)。上方虚线镜 \(M_2'\) 是 \(M_2\) 经 \(G_1\) 的虚像，\(d=|M_1M_2'|\)。}{figure.3}{}}
