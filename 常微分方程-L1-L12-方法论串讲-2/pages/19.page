  - elementId: hrule
    elementType: shape
    bounds: [48, 202, 864, 1]
    shapeName: rect
    fill: {type: solid, color: "#B9C4B4"}
    border: {width: 0, color: "#B9C4B4"}
  - elementId: c0_0
    elementType: text
    bounds: [48, 213, 228, 44]
    content:
      text: "y′=Py²+Qy+R，已知特解 y₁"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 14
      bold: true
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: c0_1
    elementType: text
    bounds: [288, 213, 318, 44]
    content:
      text: "①令 u=y−y₁ 得 u′=(2Py₁+Q)u+Pu²；②令 z=1/u；③z′+(2Py₁+Q)z=−P"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 14
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: c0_2
    elementType: text
    bounds: [618, 213, 282, 44]
    content:
      text: "完整答案 = 解族 + 特解 y₁；z=0 处恢复失效，解要限制在 z≠0 的区间"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 14
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: r0
    elementType: shape
    bounds: [48, 259, 864, 1]
    shapeName: rect
    fill: {type: solid, color: "#B9C4B4"}
    border: {width: 0, color: "#B9C4B4"}
  - elementId: c1_0
    elementType: text
    bounds: [48, 265, 228, 44]
    content:
      text: "y′=1+x²−2xy+y²"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 14
      bold: true
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: c1_1
    elementType: text
    bounds: [288, 265, 318, 44]
    content:
      text: "试 y₁=x 成立；z′=−1 ⟹ z=C−x"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 14
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: c1_2
    elementType: text
    bounds: [618, 265, 282, 44]
    content:
      text: "y=x+1/(C−x)，x≠C，另有 y=x（取不到）"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 14
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: r1
    elementType: shape
    bounds: [48, 311, 864, 1]
    shapeName: rect
    fill: {type: solid, color: "#B9C4B4"}
    border: {width: 0, color: "#B9C4B4"}
  - elementId: c2_0
    elementType: text
    bounds: [48, 317, 228, 44]
    content:
      text: "y=f(x,p)，p=y′"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 14
      bold: true
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: c2_1
    elementType: text
    bounds: [288, 317, 318, 44]
    content:
      text: "对 x 求导 p=fₓ+fₚ(dp/dx)"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 14
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: c2_2
    elementType: text
    bounds: [618, 317, 282, 44]
    content:
      text: "求出 x(p) 后必须用原式恢复 y，别另积分 y′=p"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 14
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: r2
    elementType: shape
    bounds: [48, 363, 864, 1]
    shapeName: rect
    fill: {type: solid, color: "#B9C4B4"}
    border: {width: 0, color: "#B9C4B4"}
  - elementId: c3_0
    elementType: text
    bounds: [48, 369, 228, 44]
    content:
      text: "y=φ(p)"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 14
      bold: true
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: c3_1
    elementType: text
    bounds: [288, 369, 318, 44]
    content:
      text: "dx/dp=φ′(p)/p ⟹ x=∫(φ′/p)dp+C，y=φ(p)"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 14
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: c3_2
    elementType: text
    bounds: [618, 369, 282, 44]
    content:
      text: "p=0 时常数候选 y≡φ(0)；除 fₚ、p 都要记账"
      fontFamily: {latin: Arial, ea: Microsoft YaHei, mac: PingFang SC, win: Microsoft YaHei}
      fontSize: 14
      color: "#243F35"
      lineHeight: 1.2
      align: left
  - elementId: r3
    elementType: shape
    bounds: [48, 415, 864, 1]
    shapeName: rect
    fill: {type: solid, color: "#B9C4B4"}
    border: {width: 0, color: "#B9C4B4"}
